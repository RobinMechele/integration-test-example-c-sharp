<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests for the Application layer's own logic: validators and pipeline behaviours.
    Command/query handlers are NOT unit tested with mocked repositories; they are covered by the
    API integration tests against a real database (see README, "Why handlers have no unit tests").
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ordering.Application.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ordering.Application\Ordering.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
