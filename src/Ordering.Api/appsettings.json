{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Ordering": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:05",
    "BatchSize": 20,
    "MaxAttempts": 5
  }
}
