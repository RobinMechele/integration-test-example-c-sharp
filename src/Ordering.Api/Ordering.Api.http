# Requests for the VS Code REST Client / Visual Studio / Rider HTTP client.
@baseUrl = http://localhost:5080

### Register a customer
# @name register
POST {{baseUrl}}/customers
Content-Type: application/json

{ "name": "Jane Doe", "email": "jane.doe@example.com" }

### Place an order
# @name place
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerId": "{{register.response.body.id}}",
  "lines": [
    { "sku": "BOOK-001", "quantity": 2, "unitPrice": 19.99 },
    { "sku": "PEN-042", "quantity": 1, "unitPrice": 2.50 }
  ]
}

### Get the order
GET {{baseUrl}}/orders/{{place.response.body.id}}

### Cancel the order
POST {{baseUrl}}/orders/{{place.response.body.id}}/cancel
Content-Type: application/json

{ "reason": "Changed my mind" }

### List the customer's orders
GET {{baseUrl}}/customers/{{register.response.body.id}}/orders

### Health
GET {{baseUrl}}/health
